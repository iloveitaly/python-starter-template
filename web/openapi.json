  "components": {
    "schemas": {
      "AppData": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Hello From Internal Python"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "AppData"
      },
      "CreateExamplePaymentSessionResponse": {
        "properties": {
          "client_secret": {
            "type": "string",
            "title": "Client Secret"
          },
          "amount_cents": {
            "type": "integer",
            "title": "Amount Cents"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_secret",
          "amount_cents",
          "currency",
          "product_name"
        ],
        "title": "CreateExamplePaymentSessionResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Param"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "Standard error payload returned to clients.\n\nShape loosely follows Stripe: machine-readable `code`, human-readable\n`message`, optional `param` pointing at the offending field, and an\noptional `details` bag for structured context."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Envelope wrapping `ErrorDetail` under an `error` key.\n\nThe wrapper gives error responses a stable shape (`{\"error\": {...}}`)\nthat clients can discriminate on, and leaves room to add sibling\ntop-level fields later (e.g., `request_id`, `meta`) without a\nbreaking change."
      },
      "ExamplePaymentPendingRequest": {
        "properties": {
          "client_secret": {
            "type": "string",
            "title": "Client Secret"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_secret"
        ],
        "title": "ExamplePaymentPendingRequest"
      },
      "ExamplePaymentPendingResponse": {
        "properties": {
          "stripe_checkout_session_id": {
            "type": "string",
            "title": "Stripe Checkout Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stripe_checkout_session_id"
        ],
        "title": "ExamplePaymentPendingResponse"
      },
      "ExamplePaymentStatusResponse": {
        "properties": {
