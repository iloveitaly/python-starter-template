TOFU_GLOBAL_OPTIONS := ""

# check current azure subscription
debug:
	az account show
	op item list

# setup tofu providers
tofu_init:
    tofu {{ TOFU_GLOBAL_OPTIONS }} init

# upgrade tofu provider version
tofu_upgrade:
    tofu init -upgrade

# init each run to make sure latest package versions are pulled
tofu_apply:
    tofu {{ TOFU_GLOBAL_OPTIONS }} apply

tofu_output:
    tofu {{ TOFU_GLOBAL_OPTIONS }} output -json

# opentofu repl, helpful for inspecting
tofu_play:
    tofu {{ TOFU_GLOBAL_OPTIONS }} console

# scan terraform for misconfigurations and live credentials
[script]
lint:
	# run both scanners so one failure does not hide the other
	set +e

	checkov --directory . --framework terraform --compact --quiet
	checkov_status=$?

	trufflehog filesystem . --fail --no-update --fail-on-scan-errors
	trufflehog_status=$?

	if [ "$checkov_status" -ne 0 ] || [ "$trufflehog_status" -ne 0 ]; then
		exit 1
	fi
